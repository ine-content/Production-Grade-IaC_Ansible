# .env - Production-Grade IaC with Ansible
#
# Pre-created for you in every lab folder in this course, so you can run
# things by hand immediately without an extra setup step. Username and
# password are both "api" for every environment - this is a local mock
# fleet, not a real device, so there's nothing sensitive to protect here.
# .env is still git-ignored (see .gitignore) and still never committed -
# same rule as if you'd created it yourself from .env.example.
#
# mock_device_server.py reads this file directly (via its own
# _load_dotenv()) the moment it starts, so it always matches whatever is
# in this file.
#
# ansible-playbook does NOT read .env files itself - only the mock server
# script does. If you're running ansible-playbook by hand (not through
# grading.py, which sets these itself), export this file into your shell
# first, or these values never reach lookup('env', 'RESTCONF_...') in
# site.yml:
#
#   set -a && source .env && set +a
#   ansible-playbook -i inventory/devices.py site.yml
#
# grading.py never needs this step - it sets its own fixed test
# credentials directly in its own process before starting the mock fleet
# and running the playbook, so grading works the same way regardless of
# what's in this file.

RESTCONF_PROD_USERNAME=api
RESTCONF_PROD_PASSWORD=api

RESTCONF_STAGING_USERNAME=api
RESTCONF_STAGING_PASSWORD=api
